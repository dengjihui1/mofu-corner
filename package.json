{
  "name": "mofu-corner",
  "version": "0.8.0",
  "private": true,
  "description": "绒角 MofuCorner：住在桌面角落的十二生肖毛绒伙伴",
  "type": "module",
  "main": "desktop/main.cjs",
  "bin": {
    "mofucorner": "bin/paperpal.mjs",
    "paperpal": "bin/paperpal.mjs"
  },
  "scripts": {
    "start": "node setup.mjs",
    "setup": "node setup.mjs",
    "preview": "node bin/paperpal.mjs preview",
    "doctor": "node bin/paperpal.mjs doctor",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node tests/run-desktop.mjs",
    "test:setup": "node tests/run-setup.mjs",
    "test:preview": "node tests/run-preview.mjs",
    "test:zodiac": "node tests/run-zodiac.mjs",
    "check": "node scripts/check.mjs",
    "test:motion": "node tests/run-motion.mjs",
    "test:rabbit": "node tests/run-rabbit.mjs",
    "package:source": "node scripts/package-source.mjs",
    "test:platform": "node --test tests/platform.test.mjs",
    "docs:screenshots": "node scripts/capture-docs.mjs",
    "social:start": "node server/setup.mjs",
    "social:test": "npm test --prefix server",
    "test:social-desktop": "node tests/run-social.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@larksuite/cli": "1.0.98",
    "electron": "43.8.4",
    "three": "0.186.1"
  }
}
